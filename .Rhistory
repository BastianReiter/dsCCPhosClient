TestData <- readRDS("../Data/CCP/CCPTestData2026.rds")
CCPConnections <- dsCCPhosClient::ConnectToVirtualCCP(CCPData = TestData,
NumberOfServers = 3,
NumberOfPatientsPerServer = 2500,
AddedDsPackages = c("dsFreda",
"dsTidyverse"))
CCP.LoadRawDataSet(ServerSpecifications = NULL)
# Transform Raw Data Set (RDS) into Curated Data Set (CDS) (using default settings)
dsFredaClient::ds.CurateData(RawDataSetName = "CCP.RawDataSet",
Module = "CCP",
OutputName = "CCP.CurationOutput")
# Run ds.AugmentData
ds.CCP.AugmentData(CuratedDataSetName = "CCP.CuratedDataSet",
OutputName = "CCP.AugmentationOutput",
MetaDataKey = "26e007815c68f4b3dbb5f9c0c218eb505a3ea1c485e96659")
